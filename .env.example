# --- Backend mode: "real" loads models from MODELS_DIR; "mock" uses labelled mock backends ---
BACKEND_MODE=real

# --- Audio / VAD ---
AUDIO_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=300
VAD_SPEECH_PAD_MS=100
VAD_MIN_SPEECH_MS=64
VAD_MAX_SEGMENT_SECONDS=15

# --- ASR (faster-whisper) ---
ASR_MODEL_SIZE=base          # tiny, base, small, medium, large-v3, turbo, or a local CT2 dir
ASR_DEVICE=auto              # auto, cpu, cuda
ASR_COMPUTE_TYPE=auto        # auto -> float16 on cuda, int8 on cpu
ASR_BEAM_SIZE=1
ASR_MIN_CHUNK_SECONDS=1.0
ASR_BUFFER_MAX_SECONDS=30
ASR_LOCAL_AGREEMENT_N=2

# --- NMT (NLLB-200 via CTranslate2) ---
NMT_MODEL_DIR=./models/nllb-200-distilled-600M-ct2
NMT_TOKENIZER=facebook/nllb-200-distilled-600M
NMT_DEVICE=auto
NMT_COMPUTE_TYPE=auto
NMT_BEAM_SIZE=2
NMT_MAX_BATCH_SIZE=16
NMT_BATCH_WINDOW_MS=20
NMT_MAX_INPUT_TOKENS=512

# --- TTS ---
TTS_ENGINE=piper             # piper (voices in TTS_VOICES_DIR), mock
TTS_VOICES_DIR=./models/tts
TTS_OUTPUT_SAMPLE_RATE=24000
TTS_CHUNK_MS=100

# --- LiveKit ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_that_is_at_least_32_characters_long

# --- Latency budgets (ms) ---
BUDGET_E2E_MS=2000
BUDGET_ASR_MS=1000
BUDGET_NMT_MS=500
BUDGET_TTS_MS=500

# --- Misc ---
LOG_LEVEL=INFO
MODELS_DIR=./models
CACHE_DIR=./cache
